{
  "name": "demoblaze-playwright-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web",
    "test:mobile": "playwright test --project=mobile",
    "test:ui": "playwright test --project=web --project=mobile",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=web --headed",
    "test:debug": "playwright test --project=web --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.12.1",
    "allure-playwright": "^3.12.1",
    "dotenv": "^17.2.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
